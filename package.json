    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "express": "^4.21.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "react": "^18.3.1",
